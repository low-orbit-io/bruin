name: Update Lockfile

on:
  push:
    branches: [master]
    paths:
      - "package.json"
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

jobs:
  update-lockfile:
    name: Update Lockfile
    runs-on: ubuntu-latest
    if: >-
      ${{ github.event_name == 'workflow_dispatch' ||
      github.event.head_commit.message != 'chore: update pnpm-lock.yaml' }}
    steps:
      - uses: actions/checkout@v5
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v6
        with:
          node-version: "lts/*"
          cache: "pnpm"
      - name: Install dependencies
        run: pnpm install
      - name: Check for changes
        id: verify-changed-files
        run: |
          if [ -n "$(git status --porcelain pnpm-lock.yaml)" ]; then
            echo "changed=true" >> $GITHUB_OUTPUT
          else
            echo "changed=false" >> $GITHUB_OUTPUT
          fi
      - name: Create PR with lockfile update
        if: steps.verify-changed-files.outputs.changed == 'true'
        uses: peter-evans/create-pull-request@v5
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          commit-message: "chore: update pnpm-lock.yaml"
          title: "chore: update pnpm-lock.yaml"
          body: "Automatically updated lockfile to match package.json changes"
          branch: "chore/update-lockfile"
          delete-branch: true
