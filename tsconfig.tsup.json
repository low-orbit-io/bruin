{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@testing-library/jest-dom"],
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-tsup", "tests"]
}
